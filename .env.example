# --- FACEIT Data API: two keys, two jobs (developers.faceit.com → App Studio → API keys) ---
# SERVER key ("server side"). Used only by our server for every banner and the live list. It never reaches the browser.
# Rate limit is 20 requests per second per key; the server queues to FACEIT_RPS (default 16) and caches.
FACEIT_SERVER_KEY=your-faceit-server-side-key
# Optional: lower or raise the server's own ceiling (requests per second, default 16).
# FACEIT_RPS=16
# BROWSER key ("client side"). Public on purpose: it is built into the page and only used as a fallback when our
# server answers 429/5xx, so a busy server does not leave a banner empty. Needs a rebuild after a change.
VITE_FACEIT_CLIENT_KEY=your-faceit-client-side-key

# Older setups keep working: FACEIT_SERVER_KEY, then FACEIT_API_KEY, then VITE_FACEIT_API_KEY is used by the server.
# VITE_FACEIT_API_KEY=your-faceit-api-key
# Live profile/badge cache: 6h (kept in Redis too); legacy ID-only stats: 10m; a 429 pauses lookups for 1 min.
# The live list is built once per 15 minutes; each build fetches at most 40 cold profiles at low priority.

# Opcjonalnie — build testowy z banerem „experimental”
# VITE_IS_TESTING=true

# --- Logowanie FACEIT i panel admina (backend w server/, nie trafia do bundla) ---
# Klient OAuth2 z developers.faceit.com → App Studio. Redirect URL: {PUBLIC_URL}/api/auth/callback
FACEIT_OAUTH_CLIENT_ID=
FACEIT_OAUTH_CLIENT_SECRET=
# FACEIT guid kont z dostępem do /admin (po przecinku)
ADMIN_FACEIT_GUIDS=
# Publiczny adres aplikacji (bez / na końcu); lokalnie np. http://localhost:5173
PUBLIC_URL=https://faceitbanner.vxh.pl
# Opcjonalne: bez nich sesje, historia logowań i lista banerów na żywo są w pamięci procesu.
# Redis trzyma listę live przez 15 minut, więc restart procesu nie zeruje licznika.
# REDIS_URL=redis://:haslo@srv-captain--faceitbanner-redis:6379
# DATABASE_URL=postgres://postgres:haslo@srv-captain--faceitbanner-db:5432/faceitbanner

# Lokalny dev: `pnpm dev:services` (docker-compose.dev.yml) i wartości:
# DATABASE_URL=postgres://postgres:dev@127.0.0.1:5434/faceitbanner
# REDIS_URL=redis://:dev@127.0.0.1:6381
# PUBLIC_URL=http://localhost:5173
# Testy web/ (opcjonalne, domyślnie lokalne kontenery z docker-compose.dev.yml):
# DATABASE_URL_TEST=postgres://postgres:dev@127.0.0.1:5434/faceitbanner_test
# REDIS_URL_TEST=redis://:dev@127.0.0.1:6381/15

# Lokalne logowanie FACEIT wymaga https: pnpm dev:https (plik .env.https z danymi klienta lokalnego, poza gitem)
# Fałszywy admin tylko na localhost: pnpm dev:admin (albo npm run dev:admin). Nie ustawiaj DEV_ADMIN na CapRover.

# Cloudflare R2 (attachments; private bucket, server-side uploads)
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
